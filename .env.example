# ============================================================
# Cositas Lindas Neno — variables de entorno
# Copiá este archivo como .env y completá los valores reales.
# ============================================================

# --- Base de datos (Supabase Postgres — pooler de transacciones) ---
# Supabase Dashboard → Settings → Database → Connection string → **Session pooler** (puerto 5432; el de transacciones 6543 cuelga prisma migrate)
DATABASE_URL="postgresql://postgres.[PROYECTO]:[PASSWORD]@aws-0.[REGION].pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=5"

# --- Autenticación (JWT en cookie httpOnly) ---
# Generar con: openssl rand -hex 32   (mínimo 32 caracteres)
JWT_SECRET=""

# --- Sitio ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_TIENDA_NOMBRE="Cositas Lindas Neno"

# --- WhatsApp de la tienda (formato internacional sin +, ej: 5491122334455) ---
# Se usa para el botón "Confirmar pedido por WhatsApp".
# Luego se puede cambiar desde /admin/config.
NEXT_PUBLIC_WHATSAPP_NUMERO=""

# --- Supabase Storage (fotos de productos) ---
SUPABASE_URL="https://[PROYECTO].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# --- Datos de los usuarios creados por el seed (pnpm db:seed) ---
ADMIN_EMAIL="admin@cositaslindas.com"
ADMIN_PASSWORD=""
ADMIN_NENO_EMAIL="neno@cositaslindas.com"
ADMIN_NENO_PASSWORD=""
CLIENTE_EMAIL="cliente@cositaslindas.com"
CLIENTE_PASSWORD=""

# --- Supabase (Storage para fotos de productos) ---
NEXT_PUBLIC_SUPABASE_URL="https://[PROYECTO].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
